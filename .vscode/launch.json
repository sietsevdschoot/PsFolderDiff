{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
      {
          "name": "PowerShell: DebugHelp.ps1",
          "type": "PowerShell",
          "request": "launch",
          "script": "${workspaceRoot}\\src\\debughelp.ps1",
          "cwd": "${workspaceFolder}"
      },
      {
            "type": "PowerShell",
            "request": "launch",
            "name": "All tests",
            "script": "${workspaceRoot}\\tests\\runtests.ps1",
            "cwd": "${file}"
        },
        {
            "type": "PowerShell",
            "request": "launch",
            "name": "Pester FileHashLookup",
            "script": "${workspaceRoot}\\tests\\runtests.ps1",
            "args": ["${workspaceRoot}\\tests\\FileHashLookup.Tests.ps1"],
            "cwd": "${file}"
        },
        {
            "type": "PowerShell",
            "request": "launch",
            "name": "Pester FileUtils",
            "script": "${workspaceRoot}\\tests\\runtests.ps1",
            "args": ["${workspaceRoot}\\tests\\FileUtils.Tests.ps1"],
            "cwd": "${file}"
        },
        {
            "type": "PowerShell",
            "request": "launch",
            "name": "Pester DuplicateFileUtils",
            "script": "${workspaceRoot}\\tests\\runtests.ps1",
            "args": ["${workspaceRoot}\\tests\\DuplicateFileUtils.Tests.ps1"],
            "cwd": "${file}"
        },
        {
            "type": "PowerShell",
            "request": "launch",
            "name": "Pester BasicFileInfo",
            "script": "${workspaceRoot}\\tests\\runtests.ps1",
            "args": ["${workspaceRoot}\\tests\\BasicFileInfo.Tests.ps1"],
            "cwd": "${file}"
        },
        {
            "type": "PowerShell",
            "request": "launch",
            "name": "PowerShell Launch Current File",
            "script": "${file}",
            "args": [],
            "cwd": "${file}"
        },
        {
            "type": "PowerShell",
            "request": "launch",
            "name": "PowerShell Launch Current File in Temporary Console",
            "script": "${file}",
            "args": [],
            "cwd": "${file}",
            "createTemporaryIntegratedConsole": true
        },
        {
            "type": "PowerShell",
            "request": "launch",
            "name": "PowerShell Launch Current File w/Args Prompt",
            "script": "${file}",
            "args": [
                "${command:SpecifyScriptArgs}"
            ],
            "cwd": "${file}"
        },
        {
            "type": "PowerShell",
            "request": "attach",
            "name": "PowerShell Attach to Host Process",
            "processId": "${command:PickPSHostProcess}",
            "runspaceId": 1
        },
        {
            "type": "PowerShell",
            "request": "launch",
            "name": "PowerShell Interactive Session",
            "cwd": "${workspaceRoot}"
        }
    ]
}