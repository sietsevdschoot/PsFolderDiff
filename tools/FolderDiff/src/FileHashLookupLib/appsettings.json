{
  "NLog": {
    "throwConfigExceptions": true,
    "internalLogLevel": "Fatal",
    "internalLogFile": "c:\\temp\\internal-nlog.txt",
    "targets": {
      "async": true,
      "logconsole": {
        "type": "Console",
        "layout": "${BasicLayout}"
      },
      "file": {
        "type": "File",
        "layout": "${DefautLayout}",
        "fileName": "${environment:Temp}\\FileHashLookup\\Logs\\logfile.${shortdate}.txt",
        "archiveFileName": "${environment:Temp}\\FileHashLookup\\Logs\\logfile.${shortdate}.{####}.txt",
        "archiveAboveSize ": "10000000" /* 10 MB */,
        "archiveNumbering ": "Sequence",
        "concurrentWrites ": "true",
        "keepFileOpen": "false",
        "maxArchiveFiles": "50",
        "encoding": "utf-8"
      }
    },
    "rules": [
      {
        "logger": "*",
        "minLevel": "Debug",
        "writeTo": "logconsole"
      },
      {
        "logger": "*",
        "minLevel": "Debug",
        "writeTo": "file"
      }
    ],
    "variables": {
      "DefautLayout": "${time} ${uppercase:${level}} ${logger:shortName=true} | ${message} ${onexception:| Exception occurred\\:${exception:format=tostring}}",
      "BasicLayout": "${message}",
      "MainLayout": "${when:when=regex-matches('${logger}', '(MyHttpLogger|SpotifySearchService|LoggerWriter)'):inner=${BasicLayout}:else=${DefautLayout}}"
    }
  }
}